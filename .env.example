# ===========================================
# WARUNGKU - ENVIRONMENT VARIABLES
# ===========================================
# Copy this file to .env.local and fill in your values
# NEVER commit .env.local to git!

# ===========================================
# SUPABASE CONFIGURATION (REQUIRED)
# ===========================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api

# Supabase Project URL
# Example: https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (safe to expose in frontend)
# This is the "anon" / "public" key - NOT the service_role key!
# Example: eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# ===========================================
# WORKER/BACKEND ONLY (DO NOT PREFIX WITH VITE_)
# ===========================================
# These are used in Cloudflare Worker secrets and Vercel Environment Variables

# Supabase Service Role Key (NEVER expose to frontend!)
# Set this via: wrangler secret put SUPABASE_SERVICE_ROLE_KEY
# For Vercel: Add in Project Settings > Environment Variables
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cron Job Secret (Optional - for securing cron endpoints)
# For Vercel: Add in Project Settings > Environment Variables
# Generate a random string: openssl rand -base64 32
CRON_SECRET=your-random-cron-secret-here

# ===========================================
# CLOUDFLARE D1 (Current - will be deprecated)
# ===========================================
# These are configured in wrangler.jsonc, not here

# ===========================================
# OPTIONAL: FEATURE FLAGS
# ===========================================

# Enable/Disable Real-time Sync (default: true)
# Real-time sync automatically updates data across all devices
VITE_ENABLE_REALTIME=true

# Enable/Disable Analytics (default: false)
VITE_ENABLE_ANALYTICS=false

# ===========================================
# DEVELOPMENT ONLY
# ===========================================

# Default Store ID for public access (omzetin store)
# Used when user is not authenticated
# VITE_DEFAULT_STORE_ID=6c65a321-3576-4a38-a834-19afa1c4d83e

# Enable debug logs
# VITE_DEBUG=false
